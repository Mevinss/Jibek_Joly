      "type": "boolean"
    },
    "validation": {
      "additionalProperties": true,
      "title": "Validation",
      "type": "object"
    },
    "runtime_violations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Runtime Violations",
      "type": "array"
    },
    "runtime_events": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Runtime Events",
      "type": "array"
    },
    "resource_observations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Resource Observations",
      "type": "array"
