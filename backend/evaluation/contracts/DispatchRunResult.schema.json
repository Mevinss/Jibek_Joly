            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Final Arrival"
        },
        "actual_final_arrival": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Final Arrival"
        },
        "final_delay_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Delay Min"
        },
        "delay_at_incident_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
